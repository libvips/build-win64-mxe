@@ -881,7 +881,9 @@ fn load_image_with_image_rs(
         let cursor = Cursor::new(&bytes);
 
         let mut reader = image::ImageReader::with_format(cursor, format);
-        reader.no_limits();
+        if load_options.unlimited_size {
